<h1>Carrito</h1>

{{#if cart.products.length}}
    <ul class="products-grid">
        {{#each cart.products}}
            <li>
                <strong>{{this.product.title}}</strong>
                <span>ID: {{this.product._id}}</span>
                <span>Precio: ${{this.product.price}}</span>
                <span>Categoría: {{this.product.category}}</span>
                <span>Cantidad: {{this.quantity}}</span>
            </li>
        {{/each}}
    </ul>
{{else}}
    <p>Este carrito no tiene productos.</p>
{{/if}}